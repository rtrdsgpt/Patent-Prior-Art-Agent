# Copy to .env and fill in. Never commit the real .env (already gitignored).

# LLM (Groq, same provider as Financial Anomaly Detection Using RAG)
GROQ_API_KEY=

# BigQuery (Google Patents Public Data) — needs a GCP project with the
# BigQuery API enabled; `gcloud auth application-default login` also works
# in place of a service-account key file.
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional overrides -- see src/config/settings.py for defaults
# TARGET_CPC_CLASS=G06N3
# VECTOR_STORE_BACKEND=chroma
# CHROMA_PERSIST_DIRECTORY=chroma_db
